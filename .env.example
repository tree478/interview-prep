# Copy to .env.local and fill in. Never commit .env.local.

# false calls the real API routes. NEXT_PUBLIC_* values are inlined at build time,
# so changing this in Vercel does nothing until the next deploy (clear the build cache).
# Omit it, or set anything other than false, to keep mocks on.
NEXT_PUBLIC_USE_MOCKS=false

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (aistudio.google.com -> Get API key). Server-only; read on each request.
# gemini-3.1-flash-lite is a model that currently has quota.
# gemini-3.5-flash-lite is over the daily free limit. gemini-3.5-flash is billed
# as gemini-3.6-flash and that quota is exhausted too.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# xAI API, fallback for Scout company selection (console.x.ai, MLH promo code)
XAI_API_KEY=

# Grok Bot Scout routine webhook (from the routine's Webhook section)
GROKBOT_SCOUT_WEBHOOK_URL=
GROKBOT_SCOUT_WEBHOOK_KEY=

# Our key that Grok Bot sends in the x-ingest-key header (openssl rand -hex 32)
INGEST_KEY=

# Protects cron routes (openssl rand -hex 32)
CRON_SECRET=
